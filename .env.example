# Copiez ce fichier en .env pour le développement local (docker-compose le
# charge automatiquement). Sur SSPCloud, ces variables sont positionnées via
# le Secret/values.yaml du chart Helm — voir TUTORIEL_DEPLOIEMENT_SSPCLOUD.md.

# Nom affiché dans les titres de page.
APP_NAME=Boussole

# Base de données. Par défaut : SQLite local (aucune configuration requise).
# Pour PostgreSQL (recommandé en production / plusieurs réplicas) :
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./data/app.db

# Clé de signature des jetons de session animateur.
# IMPORTANT : à générer et fixer en production, ex. avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-secret-key

# URL publique complète de l'application (utilisée pour générer les liens
# de partage et les QR codes). Laisser vide en local : elle est déduite de
# la requête entrante.
PUBLIC_BASE_URL=

# Activer les logs détaillés.
DEBUG=false
